<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Synergic_POS_Offline" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Every AlertDialog uses this theme, so custom-card popups wrap tightly to
             their card and stay centred instead of the card sitting left-aligned
             inside a wider min-width window. -->
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Dialog theme: no enforced minimum width, so the window hugs its content and
         a fixed-width custom card centres on screen instead of sitting left-aligned
         inside a wider min-width window. The window background is intentionally left
         at the default here: popups with their own card set a transparent background
         themselves, while those that rely on the standard dialog panel (e.g. the
         add-to-cart and calculator popups) keep it. -->
    <style name="AppAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">320dp</item>
        <item name="android:windowMinWidthMinor">320dp</item>
    </style>
</resources>