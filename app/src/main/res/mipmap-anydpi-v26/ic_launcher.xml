<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon as an ADAPTIVE icon: a solid brand-yellow background with the
     Balaji Synergy POS artwork on top. The launcher cuts it to its own shape - circle,
     squircle or rounded square - so it fills edge to edge like any app's icon, instead
     of a legacy square sitting on a white plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_brand_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
