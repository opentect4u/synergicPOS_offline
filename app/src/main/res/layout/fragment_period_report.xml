<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen every period report shares: a date range in, a table of rows out, with
  the period's totals under them. Tax Report and Returned Bill Report are both this
  layout with different columns in it - see PeriodReportFragment.

  The table is wider than any tablet shows at a readable size, so it scrolls sideways
  inside its card. The summary sits outside that scroll: it is the part of the report
  most often wanted, and it must not be somewhere off to the right.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Criteria -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dates and every action in the one row - Generate, Print and the
                     two downloads are icon-only buttons (see the style block each
                     repeats below) so all six fit beside the dates rather than
                     needing a row of their own underneath. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPeriodFrom"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="From date"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPeriodFrom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="none"
                            android:textSize="13sp"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPeriodTo"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="10dp"
                        android:hint="To date"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPeriodTo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="none"
                            android:textSize="13sp"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Generate - filled, the one button on this row that is not
                         outlined, so it still reads as the primary action even
                         without a label naming it that. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPeriodGenerate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@android:drawable/ic_menu_search"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:cornerRadius="12dp"
                        android:contentDescription="Generate report" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPeriodPrint"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:enabled="false"
                        app:icon="@drawable/ic_print"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:cornerRadius="12dp"
                        android:contentDescription="Print" />

                    <!-- Download the generated report. Off until there is one, like
                         Print: a file of the last report, or of nothing, is worse than
                         a button that says it is not ready. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPeriodPdf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:enabled="false"
                        app:icon="@drawable/ic_file_pdf"
                        app:iconSize="20dp"
                        app:iconPadding="0dp"
                        app:iconTint="@null"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        android:contentDescription="Download as PDF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPeriodExcel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:enabled="false"
                        app:icon="@drawable/ic_file_excel"
                        app:iconSize="20dp"
                        app:iconPadding="0dp"
                        app:iconTint="@null"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        android:contentDescription="Download as Excel" />
                </LinearLayout>

                <!-- An optional dropdown - a payment mode, an operator, whatever the
                     report narrows by. Hidden unless the screen declares one, so a
                     report with nothing to filter on shows only its dates. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPeriodFilter"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actPeriodFilter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nothing generated yet, or a period with nothing in it -->
        <LinearLayout
            android:id="@+id/llPeriodEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:alpha="0.35"
                app:tint="@color/text_secondary"
                android:contentDescription="No report yet" />

            <TextView
                android:id="@+id/tvPeriodEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No report generated"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvPeriodEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="24dp"
                android:text="Pick a date range, then Generate."
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- The report -->
        <LinearLayout
            android:id="@+id/llPeriodResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPeriodHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <HorizontalScrollView
                    android:id="@+id/hsvPeriodTable"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- Filled by the fragment, so the header cannot drift from
                             the rows it labels: both are built from one column list. -->
                        <LinearLayout
                            android:id="@+id/llPeriodHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D8DCE0" />

                        <!-- Recycled, not a view per cell: a month of a busy till is
                             thousands of rows, and a TextView per figure would be
                             laid out before the report could appear. Its width is
                             set in code to the columns' total, so it scrolls
                             sideways with the header above it. -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPeriodRows"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:scrollbars="vertical" />
                    </LinearLayout>
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- Period summary. Outside the sideways scroll on purpose. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Folded shut by default - see
                         PeriodReportFragment.setSummaryExpanded. The header carries
                         the total while it is; tapping it (or the chevron) unfolds
                         llPeriodSummary below to the full breakdown. -->
                    <LinearLayout
                        android:id="@+id/llPeriodSummaryHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SUMMARY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <!-- Shown only while the detail below is folded shut. -->
                        <TextView
                            android:id="@+id/tvPeriodSummaryTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />

                        <ImageButton
                            android:id="@+id/btnTogglePeriodSummary"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand_less"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Expand summary" />
                    </LinearLayout>

                    <!-- One row per figure, built by the fragment from the same
                         report object the rows and the printout come from. -->
                    <LinearLayout
                        android:id="@+id/llPeriodSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
