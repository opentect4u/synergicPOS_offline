<?xml version="1.0" encoding="utf-8"?>
<!--
  The slip printed when a due is collected on the Advance Payment screen - a plain
  "CUSTOMER BILL" acknowledgement: a bill-no/date/time head, the customer's details
  and the money received, then the running balance, each block split by a rule.
  Laid out at 300dp for 80mm paper and scaled by PaymentReceiptRenderer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPayReceipt"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvPayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:text="CUSTOMER BILL" />

                <TextView style="@style/BillDashLine" />

                <!-- B. NO | Date | Time, all on one line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPayBillNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:text="B. NO:1" />

                    <TextView
                        android:id="@+id/tvPayDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:maxLines="1"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="#222222" />

                    <TextView
                        android:id="@+id/tvPayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:gravity="end"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView style="@style/BillDashLine" />

                <!-- CID / NAME / GSTIN / PREV. BALANCE / CASH RECEIVED, built in code -->
                <LinearLayout
                    android:id="@+id/llPaySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView style="@style/BillDashLine" />

                <!-- TOTAL BALANCE, built in code -->
                <LinearLayout
                    android:id="@+id/llPayTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView style="@style/BillDashLine" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
