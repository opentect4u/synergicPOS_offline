<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard is a page - see DashboardHomeFragment for why this one screen is.

  The WebView scrolls itself, so there is no ScrollView around it; nesting one would
  give the page two scrollers fighting over the same drag.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <WebView
        android:id="@+id/webDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
