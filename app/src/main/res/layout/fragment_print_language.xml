<?xml version="1.0" encoding="utf-8"?>
<!--
  Print Language: one radio per language, and a line under the list saying what the
  choice does and does not reach. The radios are added in code from
  PrintLanguage.Language rather than declared here, so adding a language is one
  entry in that enum and its dictionary column - not an entry there plus a
  RadioButton here that somebody has to remember to keep in step.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvPrintLanguageHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRINT LANGUAGE"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue" />

                <TextView
                    style="@style/BillSettingSub"
                    android:layout_marginTop="4dp"
                    android:text="The language bills and reports are printed in. Takes effect on the next slip - nothing already printed changes." />

                <RadioGroup
                    android:id="@+id/rgPrintLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The shop's own product names, as this language will print them. The one
             place an operator can judge the respelling before a customer does. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProductNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvProductNamesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR PRODUCT NAMES"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue" />

                <TextView
                    android:id="@+id/tvProductNamesNote"
                    style="@style/BillSettingSub"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:id="@+id/llProductNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvPrintLanguageScopeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHAT IT CHANGES"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue" />

                <TextView
                    android:id="@+id/tvPrintLanguageScope"
                    style="@style/BillSettingSub"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
