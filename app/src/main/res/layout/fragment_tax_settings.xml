<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ============ DISCOUNT ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView android:id="@+id/tvDiscountHeader"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DISCOUNT" android:textSize="12sp" android:letterSpacing="0.08"
                    android:textStyle="bold" android:textColor="@color/primary_blue" />

                <!-- Discount Type master toggle -->
                <LinearLayout style="@style/BillSettingRow">
                    <LinearLayout style="@style/BillSettingText">
                        <TextView style="@style/BillSettingTitle" android:text="Discount Type" />
                        <TextView style="@style/BillSettingSub" android:text="Enable discounts on bills and items" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swDiscount" style="@style/BillSettingSwitch" />
                </LinearLayout>

                <!-- Discount options (shown only when Discount Type is ON) -->
                <LinearLayout
                    android:id="@+id/llDiscountOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/BillSettingDivider" />

                    <TextView style="@style/BillSettingTitle" android:text="Discount type"
                        android:layout_marginTop="14dp" />
                    <TextView style="@style/BillSettingSub" android:text="Choose one discount type" />

                    <RadioGroup
                        android:id="@+id/rgDiscountType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp">

                        <RadioButton android:id="@+id/rbTypeItem" style="@style/BillSettingRadio"
                            android:text="Item wise discount" />
                        <RadioButton android:id="@+id/rbTypeBill" style="@style/BillSettingRadio"
                            android:text="Bill wise discount" />
                    </RadioGroup>

                    <!-- Discount position is not a choice: it follows from the type
                         (item-wise pre-tax, bill-wise post-tax), so this block stays
                         hidden whether or not GST/VAT is on. Kept, rather than
                         deleted, so the rule can be handed back to the operator
                         without rebuilding the screen. -->
                    <LinearLayout
                        android:id="@+id/llDiscountPosition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/BillSettingDivider" />

                        <TextView style="@style/BillSettingTitle" android:text="Discount position"
                            android:layout_marginTop="14dp" />
                        <TextView style="@style/BillSettingSub"
                            android:text="Required when discount is on — choose one" />

                        <RadioGroup
                            android:id="@+id/rgDiscountPosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">

                            <!-- Pre-tax is no longer disabled here. It is switched on
                                 and off in code, by the tax mode: it means nothing
                                 under MRP, where the tax is already inside the price.
                                 See TaxSettingsFragment.syncDiscountPosition. -->
                            <RadioButton android:id="@+id/rbPosPre" style="@style/BillSettingRadio"
                                android:text="Pre-tax discount" />
                            <RadioButton android:id="@+id/rbPosPost" style="@style/BillSettingRadio"
                                android:text="Post-tax discount" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ TAX ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView android:id="@+id/tvTaxHeader"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TAX" android:textSize="12sp" android:letterSpacing="0.08"
                    android:textStyle="bold" android:textColor="@color/primary_blue" />

                <TextView style="@style/BillSettingSub"
                    android:text="Which tax a product carries - GST or VAT - is set on the product itself" />

                <!-- Tax -->
                <LinearLayout style="@style/BillSettingRow">
                    <LinearLayout style="@style/BillSettingText">
                        <TextView style="@style/BillSettingTitle" android:text="Tax" />
                        <TextView style="@style/BillSettingSub" android:text="Charge each product at whatever GST or VAT rate it carries" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swTax" style="@style/BillSettingSwitch" />
                </LinearLayout>

                <!-- Tax mode (shown only when Tax is ON) -->
                <RadioGroup
                    android:id="@+id/rgTaxMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="4dp"
                    android:visibility="gone">

                    <RadioButton android:id="@+id/rbExclusive" style="@style/BillSettingRadio"
                        android:layout_width="wrap_content" android:text="Exclusive" />
                    <!-- "MRP", not "Inclusive". The id stays rbInclusive because it is
                         the same setting - GstMode.INCLUSIVE - and what changed is
                         only what a shopkeeper calls it: a price with the tax already
                         inside it is the MRP, which is the word on the box. -->
                    <RadioButton android:id="@+id/rbInclusive" style="@style/BillSettingRadio"
                        android:layout_width="wrap_content" android:layout_marginStart="24dp" android:text="MRP" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTax"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="Save Settings"
            android:textSize="16sp"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
