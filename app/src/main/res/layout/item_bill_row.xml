<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/tvRowBillNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="3"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/tvRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="SOMNATH"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/tvRowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="17-07-2026"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvRowTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:text="13:18"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Held off the action buttons so the figure reads as part of the row
             rather than as a label on the button beside it. -->
        <TextView
            android:id="@+id/tvRowAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            android:text="₹ 962.50"
            android:gravity="end"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_main" />

        <!-- Prints straight from the list, without opening the bill first. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintBillRow"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Print bill"
            app:icon="@drawable/ic_print"
            app:iconSize="20dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:iconTint="@color/text_secondary"
            app:cornerRadius="10dp"
            app:paddingStart="14dp"
            app:paddingEnd="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewBill"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="View"
            android:textSize="13sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />
</LinearLayout>
