<?xml version="1.0" encoding="utf-8"?>
<!--
  One product on the sale grid, in both trades (grocery's shelf and the restaurant's
  menu), seven to a row.

  Seven across leaves each tile roughly 70-120dp wide depending on the tablet, so the
  photo is given as a ratio rather than a fixed height: it stays a 4:3 window on every
  screen instead of towering over a narrow card. The type is sized down to match -
  small enough to fit the tile, still large enough to read a name and a price at
  arm's length across a counter.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Product photo; the caption shows through when a product has none. Height
             follows the tile's own width, so it never crowds out the name and price. -->
        <FrameLayout
            android:id="@+id/vBanner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,4:3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="#EAE9E9">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="no photo"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:textColor="#8A8A8A" />

            <ImageView
                android:id="@+id/ivProductPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product photo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Low stock"
                android:textSize="8.5sp"
                android:textColor="@color/text_main"
                android:background="@color/white"
                android:visibility="gone" />

            <!-- Restaurant-only markers. Laid on the photo the way the stock badge is,
                 so the tile is one design in both trades: a grocery never sets them and
                 they stay gone, a restaurant turns on whichever the dish has. -->
            <ImageView
                android:id="@+id/ivFoodType"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_margin="5dp"
                android:src="@drawable/ic_food_veg"
                android:contentDescription="Food type"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPrepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="5dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:maxLines="1"
                android:text="15 min"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:background="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llSpice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="5dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:background="@color/white"
                android:orientation="horizontal"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/vBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical"
            android:padding="7dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:minLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_main" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="₹ 0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/tvSku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="0000"
                    android:textSize="8.5sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
