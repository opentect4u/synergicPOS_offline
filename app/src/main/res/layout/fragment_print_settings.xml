<?xml version="1.0" encoding="utf-8"?>
<!--
  Printer Settings: the connection list and the bill print template, one tab each.
  The tab strip is the only thing this layout owns - each tab's content is a child
  fragment swapped into printSettingsContent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsPrintSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E4E4" />

    <FrameLayout
        android:id="@+id/printSettingsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
