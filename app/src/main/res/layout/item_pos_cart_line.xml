<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the grocery cart.

  SIZED SO TEN FIT, mostly. The cart column is about 438dp between the ticket header
  and the fold below it, and a bill of ten is an ordinary shop of one. At the 56dp this
  row used to stand, seven fitted and the eighth item pushed the first off the top - so
  the operator scrolled a list they had just typed, to check it against the counter.
  Ten rows in 438dp means 43dp a row, and most of the 13dp came off the parts of the
  row that were space rather than information:

      10dp -> 5dp   vertical padding, top and bottom
      -4dp each     includeFontPadding on both lines of text, which is invisible
                    leading the font asks for and this row cannot afford

  The stepper and the delete button are the exceptions, and deliberately spend back
  some of that room: they went 30dp -> 28dp in the pass above, then back up to 34dp
  each - a counter's + and - are tapped far more than anything else on the row, and a
  mistouch there is a wrong quantity on the bill rather than a cosmetic slip; a mistap
  on delete is the whole line gone, reaching for it with a thumb and finding the line
  total or the stepper instead. Ten rows is the target, not a limit enforced at either's
  expense.

  Nothing else was taken out to get there: the name, the unit price and the line total
  are all still on it, at the same sizes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Scroll Marker (Accent for newest item) - a bit wider than a plain rule,
             so the row it marks does not start flush against the panel's own edge. -->
        <View
            android:id="@+id/vNewMarker"
            android:layout_width="8dp"
            android:layout_height="32dp"
            android:background="@color/primary_blue"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="5dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Name + unit price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Item"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/tvLineEach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹ 0 each"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Qty stepper - the pair a counter's thumb lands on most, so it is
                 sized well past the row's other tap targets rather than squeezed
                 to match them; see the file's own note above. -->
            <ImageButton
                android:id="@+id/btnMinus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="@color/text_secondary"
                android:contentDescription="Decrease" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@color/text_secondary"
                android:contentDescription="Increase" />

            <!-- Line total -->
            <TextView
                android:id="@+id/tvLineTotal"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                android:gravity="end"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <!-- Delete - sized with the stepper, not squeezed to fit the row: a
                 mistap here is a wrong finger reaching for it and landing on the
                 line total or the stepper beside it instead. -->
            <ImageButton
                android:id="@+id/btnRemoveLine"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/menu_delete_icon"
                android:contentDescription="Remove" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />
</LinearLayout>
