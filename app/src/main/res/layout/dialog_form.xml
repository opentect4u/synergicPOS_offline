<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/white">

    <!-- A fixed width, narrowed by DialogUtils to whatever the screen actually has
         when the device is set to a large display size and 450dp no longer fits
         across it. -->
    <LinearLayout
        android:id="@+id/llFormContent"
        android:layout_width="450dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Title with a close cross laid OVER its right-hand end, rather than beside
             it in a row: the title stays centred on the card the way it always was,
             and the cross does not push it off-centre or steal width from a long one.
             Gone unless the caller asks for it - see DialogUtils.showForm's showClose.
             A form reached from a menu is left as it was, where the buttons below are
             the way out; the cross is for one raised over the sale screen mid-sale. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Edit"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:textColor="@color/text_main" />

            <ImageButton
                android:id="@+id/btnFormClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Weighted so that when the form is taller than the screen, it is this
             that gives up height and scrolls - not the button row below it. -->
        <com.example.synergic_pos_offline.utils.MaxHeightScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginBottom="20dp"
            android:maxHeight="450dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <GridLayout
                    android:id="@+id/glFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="true"
                    android:useDefaultMargins="false" />

                <LinearLayout
                    android:id="@+id/llSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pos_hint_bg" />
            </LinearLayout>
        </com.example.synergic_pos_offline.utils.MaxHeightScrollView>

        <!-- Unweighted, so a long form can never squeeze the buttons down to a
             sliver with their labels clipped away. The buttons stand 48dp tall at
             minimum but are free to grow: a height fixed at 48dp clips the label
             inside instead, which is the same clipping one row up. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormNegative"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:maxLines="2"
                android:text="Cancel"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormPositive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:maxLines="2"
                android:text="Save"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>