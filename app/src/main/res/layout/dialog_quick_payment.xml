<?xml version="1.0" encoding="utf-8"?>
<!--
  Settlement for a TAKE-AWAY order, taken where the order is rather than on a screen
  of its own.

  A take-away is settled at the counter while the customer stands there: pick how they
  are paying, take the money, done. The full checkout screen exists for a table - it
  shows the itemised bill because a table's bill is read and queried before it is paid
  - but a counter order has just been rung up in front of the person paying for it, so
  a page that lists it back is a page to get past. This asks the two things that are
  not already known and nothing else.

  Ids are prefixed Qp so they cannot collide with the checkout screen's, which carry
  their own theming; the action buttons keep the btnForm* names so ThemeManager paints
  them the way it paints every other dialog's.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/white">

    <!-- THE WHOLE POPUP SCROLLS. With part payment and credit on it, it can be taller
         than the space left once the keyboard is up, and the cash / UPI / credit
         boxes sat under the keyboard with no way to reach them. The dialog resizes
         for the keyboard (see showQuickPayment) and this scrolls whatever no longer
         fits, so the box being typed in is always brought into view. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svQuickPay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/llQuickPayContent"
        android:layout_width="430dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <!-- Set in code from the order's own type - this dialog settles a QSR ticket
             as well as a take-away one. The text below is only what the preview shows;
             see RestaurantOrdersFragment.showQuickPayment. -->
        <TextView
            android:id="@+id/tvQpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take Away — Settlement"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_main" />

        <!-- The token and its customer, with the customer's details behind the info
             button - the grocery checkout's btnCustInfo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textColor="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnQpCustInfo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Customer details"
                android:src="@android:drawable/ic_dialog_info"
                android:visibility="gone" />
        </LinearLayout>

        <!-- What is being paid for: every line of the order, with its quantity.

             Above the total rather than below it, because it is read first - the
             customer asks what they are paying for, and the figure they are asked for
             follows from it.

             Its height is capped in code (see showQuickPayment's QP_LIST_* constants),
             NOT by MaxHeightScrollView. That view caps at a fraction of the SCREEN,
             which is right when the scrolling part is most of a dialog and wrong here:
             everything that collects the money sits below this list, so a 30-line
             ticket claimed its 62% and pushed the pay tiles and the buttons off the
             bottom of the card. Measured: 1851px of dialog on a 1504px screen. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="14dp" />

        <!-- Nested, so the order's own list still scrolls inside the scrolling popup
             rather than the two fighting over the same drag. NestedScrollView nests by
             default - do NOT add android:nestedScrollingEnabled here: View's own
             constructor applies it before NestedScrollView has built the helper it
             forwards to, and inflating the popup crashes (NullPointerException in
             NestedScrollView.setNestedScrollingEnabled). -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svQpItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/llQpItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="6dp" />

        <!-- The amount owed, set large and on its own. It is the one figure the
             counter reads out loud, and everything under it is about collecting it. -->
        <TextView
            android:id="@+id/tvQpTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="₹ 0.00"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAYMENT METHOD"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQpCash"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cash"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQpCard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Card"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQpOnline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Online"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />

            <!-- On the customer's account - see CreditSale. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQpCredit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Credit"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Cash only. Card and Online are paid to the penny by the machine, so a
             tendered box under them is a box asking a question with one answer. -->
        <LinearLayout
            android:id="@+id/llQpCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQpTendered"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Amount Tendered (₹)"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQpTendered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Change Due"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvQpChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue" />
            </LinearLayout>
        </LinearLayout>

        <!-- PART PAYMENT under the Cash tile, as on the grocery checkout: notes and a
             UPI transfer against one bill. The panel's own CASH row takes over from
             the tendered box above while it is on. See SplitPayment. -->
        <include layout="@layout/view_split_payment" />

        <!-- Credit only: what is handed over now, and what is left on the account. -->
        <include layout="@layout/view_credit_payment" />

        <!-- Scan-to-pay, on the same terms as the checkout screen: shown while Online
             is chosen, carrying the amount so the customer confirms a figure rather
             than keying one in. -->
        <include layout="@layout/view_checkout_upi_qr" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormNegative"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancel"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormPositive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Confirm Payment"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
