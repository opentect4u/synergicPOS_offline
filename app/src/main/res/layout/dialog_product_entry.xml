<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <com.example.synergic_pos_offline.utils.MaxHeightScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- The product's own photo, so the operator can see they picked the right
             thing before committing a quantity to it - the names on a till differ by
             a size or a variant and read alike in a hurry. Hidden, taking no height,
             for a product that has no picture. -->
        <ImageView
            android:id="@+id/ivDialogPhoto"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_dialog_photo"
            android:clipToOutline="true"
            android:contentDescription="Product photo"
            android:visibility="gone" />

        <!-- Header -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/tvDialogCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Category"
            android:textSize="12sp"
            android:textColor="@color/primary_blue" />

        <!-- Stock pill. Text and colour are set per state in StockBadge; hidden
             entirely while stock is not being tracked. -->
        <TextView
            android:id="@+id/tvDialogStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Product details grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/pos_hint_bg">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="SKU" />
                    <TextView android:id="@+id/tvDetSku" style="@style/PosHeaderValue" android:text="----" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="HSN CODE" />
                    <TextView android:id="@+id/tvDetHsn" style="@style/PosHeaderValue" android:text="0000" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="UNIT" />
                    <TextView android:id="@+id/tvDetUnit" style="@style/PosHeaderValue" android:text="pcs" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="MRP" />
                    <TextView android:id="@+id/tvDetMrp" style="@style/PosHeaderValue" android:text="₹0.00" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/llDetGst" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="GST" />
                    <TextView android:id="@+id/tvDetGst" style="@style/PosHeaderValue" android:text="0%" />
                </LinearLayout>
                <LinearLayout android:id="@+id/llDetCgst" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/lblDetCgst" style="@style/PosHeaderLabel" android:text="CGST" />
                    <TextView android:id="@+id/tvDetCgst" style="@style/PosHeaderValue" android:text="0%" />
                </LinearLayout>
                <LinearLayout android:id="@+id/llDetSgst" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PosHeaderLabel" android:text="SGST" />
                    <TextView android:id="@+id/tvDetSgst" style="@style/PosHeaderValue" android:text="0%" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Rate selector (shown only when the product has multiple rates) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRateSelect"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Select rate"
            android:visibility="gone"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actRateSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rate + Quantity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Rate"
                app:prefixText="₹ "
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="18sp"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQty"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Quantity"
                app:helperTextEnabled="true"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="18sp"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Tax breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">

            <!-- Item-wise discount, shown only when Tax Settings has Discount on and set to Item wise -->
            <LinearLayout android:id="@+id/rowItemDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                <TextView android:id="@+id/tvItemDiscountLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Discount" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvItemDiscountAmt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="-₹0.00" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Taxable value" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvTaxable" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowCgst" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvCgstLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="CGST" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvCgstAmt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowSgst" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvSgstLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="SGST" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvSgstAmt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Amount" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tvLineAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text_main" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </com.example.synergic_pos_offline.utils.MaxHeightScrollView>

        <!-- Buttons: fixed footer outside the scroll, so they never get clipped. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Cancel"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogAdd"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Add to cart"
                android:textColor="@color/white"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
