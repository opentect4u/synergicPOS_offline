<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReceipt"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp">

                <!-- Header logo (md_logos BILL_HEADER), hidden when none is set -->
                <ImageView
                    android:id="@+id/ivBillHeaderLogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="76dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Store logo"
                    android:visibility="gone" />

                <!-- Store name -->
                <TextView
                    android:id="@+id/tvStoreName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="JAI HANUMAN"
                    android:gravity="center"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#111111" />

                <!-- Store address / phone / GSTIN, hidden individually when unset -->
                <TextView
                    android:id="@+id/tvStoreAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStorePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStoreGstin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <!-- Configurable header lines (md_headers) -->
                <LinearLayout
                    android:id="@+id/llBillHeaderLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Captions (md_captions): the operator's own lines for what this
                     slip is - an ordinary bill, one on credit, a reprint of one
                     already issued. Sits under the whole header block, so the store
                     identity reads first and the caption qualifies it. Empty unless
                     captions have been set up. -->
                <LinearLayout
                    android:id="@+id/llBillCaptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Date | Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="17-07-2026"
                        android:gravity="center"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textSize="13sp"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:18"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textSize="13sp"
                        android:textColor="#333333" />
                </LinearLayout>

                <TextView style="@style/BillDashLine" />

                <!-- Bill no / Name -->
                <TextView
                    android:id="@+id/tvBillNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BILL NO: 3"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="13sp"
                    android:textColor="#222222" />

                <!-- Customer details, shown per Bill Settings' "Customer Details" mode -->
                <TextView
                    android:id="@+id/tvCustMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NAME  : SOMNATH"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCustGstin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <!-- Customer address, shown when Bill Settings' "Customer Address Printing" is on -->
                <TextView
                    android:id="@+id/tvCustAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <!-- What the customer owes once this bill is on their account.
                     Credit sales only - a settled sale leaves nothing outstanding. -->
                <TextView
                    android:id="@+id/tvCustOutstanding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:visibility="gone" />

                <TextView style="@style/BillDashLine" />

                <!-- Items header. One row, the same five columns the Classic slip
                     uses and in the same proportions: BillReceiptRenderer lays these
                     out to CLASSIC_COLUMNS at inflation and sets the rows beneath
                     them from the same array, so a figure cannot end up under the
                     wrong label. The weights here are the 3-inch ones and are
                     present so the layout can be previewed. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvColSrItem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.8"
                        android:text="SR.NO ITEM"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#222222" />

                    <TextView
                        android:id="@+id/tvColQty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="QTY"
                        android:gravity="center"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#222222" />

                    <TextView
                        android:id="@+id/tvColPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.9"
                        android:text="PRICE"
                        android:gravity="end"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#222222" />

                    <!-- Hidden by the renderer when no line carries a discount - a
                         bill-wise discount comes off the total, not the lines, so
                         its column would be nothing but dashes. -->
                    <TextView
                        android:id="@+id/tvColDisc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.7"
                        android:text="DISC"
                        android:gravity="end"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#222222"
                        android:visibility="gone" />

                    <!-- The line's gross less its discount - what it actually
                         contributes to the bill. -->
                    <TextView
                        android:id="@+id/tvColNet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.3"
                        android:text="AMOUNT"
                        android:gravity="end"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView style="@style/BillDashLine" />

                <!-- Items -->
                <LinearLayout
                    android:id="@+id/llItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView style="@style/BillDashLine" />

                <!-- Bill summary: item count / qty / gross, each tax rate, discount
                     and totals as "label : value" lines. Built in code from the bill,
                     replacing the old base-amount tax table. -->
                <LinearLayout
                    android:id="@+id/llSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp" />

                <TextView style="@style/BillDashLine" />

                <!-- Amount in words -->
                <TextView
                    android:id="@+id/tvAmountWords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#333333"
                    android:visibility="gone" />

                <!-- Payment mode, one row per payment recorded against the bill -->
                <LinearLayout
                    android:id="@+id/llBillPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Who rang the sale up -->
                <TextView
                    android:id="@+id/tvBillCreatedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Created by: ---"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="12sp"
                    android:textColor="#222222" />

                <TextView style="@style/BillDashLine" />

                <!-- Configurable footer lines (md_footers) -->
                <LinearLayout
                    android:id="@+id/llBillFooterLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Footer logo (md_logos BILL_FOOTER), hidden when none is set -->
                <ImageView
                    android:id="@+id/ivBillFooterLogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="56dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Footer logo"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:gravity="center"
                    android:fontFamily="@font/roboto_mono_regular"
                    android:textSize="12sp"
                    android:textColor="#555555" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <!-- Floats over the receipt so it stays reachable while the bill scrolls -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintBill"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:text="Print"
        android:textColor="@color/white"
        app:icon="@drawable/ic_print"
        app:iconTint="@color/white"
        app:cornerRadius="12dp"
        app:elevation="4dp" />
</FrameLayout>
