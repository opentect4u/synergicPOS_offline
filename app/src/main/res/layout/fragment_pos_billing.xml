<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- ================= POS HEADER (modular cells) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <TextView
                android:id="@+id/tvBrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNERGIC POS"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvBrandSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POS TERMINAL"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:textColor="@color/primary_blue" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#EEEEEE" />

        <!-- Scrollable middle cells -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout style="@style/PosHeaderCell">
                    <TextView style="@style/PosHeaderLabel" android:text="Cashier" />
                    <TextView
                        android:id="@+id/tvCashierName"
                        style="@style/PosHeaderValue"
                        android:text="Priya Nair" />
                </LinearLayout>

                <!-- Last bill (shown only when the "Last Bill Status" setting is on) -->
                <View android:id="@+id/vLastBillDivider" android:layout_width="1dp" android:layout_height="match_parent" android:background="#EEEEEE" android:visibility="gone" />
                <LinearLayout android:id="@+id/cellLastBill" style="@style/PosHeaderCell" android:visibility="gone">
                    <TextView style="@style/PosHeaderLabel" android:text="Last Bill" />
                    <TextView android:id="@+id/tvHeaderLastBill" style="@style/PosHeaderValue" android:text="--" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:text="13:18"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculator"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="Calculator"
            app:icon="@android:drawable/ic_dialog_dialer"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:id="@+id/btnHeld"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:text="Held (0)"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#E0E0E0" />

    <!-- ================= BODY ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- PRODUCT REGION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Search + actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Add Customer"
                    app:icon="@android:drawable/ic_menu_myplaces"
                    app:cornerRadius="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Scan barcode or search name / SKU"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Category tab strip -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@color/white"
                android:clipToPadding="false"
                tools:listitem="@layout/item_pos_category" />

            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#E0E0E0" />

            <!-- Product grid -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_pos_product" />

                <TextView
                    android:id="@+id/tvNoProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No products found"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#E0E0E0" />

        <!-- CART / ORDER TICKET -->
        <LinearLayout
            android:id="@+id/cartPanel"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CURRENT SALE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:textColor="@color/primary_blue" />

                    <TextView
                        android:id="@+id/tvOrderNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INV-000001"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- Total Item Count -->
                <TextView
                    android:id="@+id/tvItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 items"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <!-- Customer -->
                <com.google.android.material.button.MaterialButton
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
                    android:id="@+id/btnAddCustomer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="+ Add loyalty customer"
                    android:textSize="13sp"
                    app:rippleColor="@android:color/transparent" />

                <LinearLayout
                    android:id="@+id/llCustomerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvCustName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customer"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_main" />

                            <ImageButton
                                android:id="@+id/btnCustomerInfo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_info_details"
                                app:tint="@color/primary_blue"
                                android:contentDescription="Customer details"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCustSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="340 pts"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnRemoveCust"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Remove customer" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

            <!-- Cart lines -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_pos_cart_line" />

                <!-- Floating Scroll Marker / Jump to Top -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJumpTop"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Show Newest"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconSize="12dp"
                    app:backgroundTint="@color/primary_blue"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvCartEmpty"
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="No items yet — scan or tap a product to begin."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E4E7EB" />

            <!-- The money end of the panel - the discount box, the breakdown and the
                 Total - folded away by default so the cart above gets the height
                 instead. The handle below pulls it back up, and carries the total
                 while it is down; the two buttons never fold, since they are what the
                 panel is used for.

                 This is the restaurant sale screen's Note & tax details fold, part for
                 part: the same input at the top, the same OrderSummary rows under it,
                 the same plain Total closing it, the same handle. The two sale screens
                 are the same screen in two trades, and an operator moving between them
                 should not have to learn the money end twice. Where they differ is
                 only in what each trade actually has - a note and a service charge
                 there, a discount box and a round-off here. -->
            <LinearLayout
                android:id="@+id/llBillingSummaryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:visibility="gone">

                <!-- The input at the top of the fold, where the restaurant's order note
                     is: same OutlinedBox (not Dense), same 12dp corners, same 18dp
                     margins off the panel edge, so the field sits on the same line and
                     stands the same height in both trades. Shown only when Tax Settings
                     has Discount off or set to Bill wise - item-wise discount is
                     entered elsewhere, per product. -->
                <LinearLayout
                    android:id="@+id/sectionDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioGroup
                        android:id="@+id/rgDiscountMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginHorizontal="18dp"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/rbDiscountPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Percentage"
                            android:textSize="12sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbDiscountAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Amount"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiscount"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="18dp"
                        android:layout_marginTop="4dp"
                        android:hint="Discount"
                        app:suffixText="%"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiscount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCouponMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textColor="@color/primary_dark"
                    android:visibility="gone" />

                <!-- The breakdown, on the shared OrderSummary styles the restaurant
                     panel uses, in a block padded exactly as its is - so a row is the
                     same height, the same 14sp, the same colouring and the same indent
                     in both trades. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="6dp">

                    <LinearLayout style="@style/OrderSummaryRow">
                        <TextView style="@style/OrderSummaryLabel" android:text="Subtotal" />
                        <TextView android:id="@+id/tvSubtotal" style="@style/OrderSummaryValue" android:text="₹ 0.00" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/rowBillingDiscount" style="@style/OrderSummaryRow">
                        <TextView android:id="@+id/tvDiscountLabel" style="@style/OrderSummaryLabel" android:text="Discount (0%)" />
                        <TextView android:id="@+id/tvDiscountAmt" style="@style/OrderSummaryValue" android:text="- ₹ 0.00" />
                    </LinearLayout>

                    <LinearLayout style="@style/OrderSummaryRow">
                        <TextView android:id="@+id/tvTaxLabel" style="@style/OrderSummaryLabel" android:text="GST" />
                        <TextView android:id="@+id/tvTax" style="@style/OrderSummaryValue" android:text="₹ 0.00" />
                    </LinearLayout>

                    <!-- Round off, shown only when the bill needs one -->
                    <LinearLayout android:id="@+id/rowBillingRoundOff" style="@style/OrderSummaryRow"
                        android:visibility="gone">
                        <TextView style="@style/OrderSummaryLabel" android:text="Round off" />
                        <TextView android:id="@+id/tvBillingRoundOff" style="@style/OrderSummaryValue" android:text="₹ 0.00" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The Total closes the breakdown it is the sum of. A plain row, not
                     the full-bleed accent bar this used to be: on a panel where the
                     figure is already repeated on the handle below, a band of solid
                     colour was shouting a number that is no longer even the one being
                     read most of the time. Identical to the restaurant's, padding
                     included. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 0.00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue" />
                </LinearLayout>
            </LinearLayout>
            <!-- /llBillingSummaryDetail -->

            <!-- The handle: says what is folded away, pulls it up, and carries the
                 total while it is down.

                 The Total went into the fold to give the cart its height back, but the
                 amount is the one figure a counter reads off this panel continuously -
                 folding it away would have bought the space with the number the screen
                 is for. So it is echoed here, at no height at all: the bar is 38dp
                 either way. Same metrics as the restaurant's handle, down to the 18sp
                 the figure is set in. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleBillingSummary"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Discount &amp; tax details"
                    android:textSize="12.5sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_expand_less"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:cornerRadius="8dp" />

                <!-- Gone while the fold is open, where the Total row is showing a few
                     lines below it - the same number twice, one above the other, reads
                     as two figures to reconcile rather than one to read. -->
                <TextView
                    android:id="@+id/tvBillingTotalBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:text="₹ 0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="#E4E7EB" />

            <!-- Actions, on one row: Hold beside Checkout.

                 Weighted 1 to 1.6 rather than evenly. A grocery holds a bill now and
                 then and settles one every time, and the button that ends the sale
                 carries an amount inside it - equal halves would give the occasional
                 action the same claim on the row as the constant one, and squeeze the
                 figure. Same 52dp, same 12dp corner and same 18dp block as the
                 restaurant's Checkout, so the primary is the same button in both
                 trades even though this one shares its row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:padding="18dp"
                android:background="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="Hold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCharge"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.6"
                    android:layout_marginStart="5dp"
                    android:text="Checkout"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:maxLines="1"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
