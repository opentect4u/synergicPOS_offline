<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/white">

    <!-- A fixed width, narrowed by DialogUtils to whatever the screen actually has
         when the device is set to a large display size and 380dp no longer fits
         across it. -->
    <LinearLayout
        android:id="@+id/llDialogContent"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:contentDescription="Dialog icon"
            android:src="@android:drawable/ic_dialog_alert"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Title"
            android:textColor="@color/text_main"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- The message SCROLLS, the buttons do not.
             A confirm can carry a long warning - the erase-bills one names what goes,
             what is kept, the numbering and the floor - and with everything in one
             wrap_content column the card simply grew past the screen, taking the
             button row off the bottom edge with it. A warning nobody can agree to or
             refuse is worse than no warning.
             MaxHeightScrollView caps itself at a fraction of the screen AND at what
             the parent has left, so short messages still wrap tight and long ones
             scroll inside the card with Cancel and Confirm always in view. -->
        <com.example.synergic_pos_offline.utils.MaxHeightScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Message"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </com.example.synergic_pos_offline.utils.MaxHeightScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Left to wrap onto a second line rather than pinned to one and
                 ellipsized: these labels are the caller's - "Print & Complete",
                 "Delete permanently" - and a button reading "Delete perm..." is
                 worse than a button two lines tall. minHeight keeps the tap target
                 whatever the label does. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogNegative"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="2"
                android:text="Cancel"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogPositive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:maxLines="2"
                android:text="Confirm"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
