<?xml version="1.0" encoding="utf-8"?>
<!--
  Choose Table: the floor plan as cards, its sections as the categories across the
  top, and a legend along the foot keying each colour to a status.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="18dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:id="@+id/llDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <!-- Title + search + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Choose Table"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search table or section"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTableSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btnCloseChooseTable"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- What the floor adds up to, for whatever section is being shown. Answers
             "is there anything free?" without counting green cards by eye. -->
        <LinearLayout
            android:id="@+id/llTableCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp" />

        <!-- Sections, as the categories of this grid -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/llTableSections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E7EB" />

        <!-- The floor -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTables"
            android:layout_width="match_parent"
            android:layout_height="470dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="14dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvNoTables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="28dp"
            android:gravity="center"
            android:text="No tables set up yet.\nAdd them in Master ▸ Table."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E7EB" />

        <!-- Legend: what each colour on the cards above means. Scrolls rather than
             squeezing, so the KOT keys can sit beside the table statuses. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/bg_light"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#16A34A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Available Table"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#DC2626" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Occupied Table"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#F59E0B" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Reserved Table"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#2563EB" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="22dp"
                    android:text="Bill Pending"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <!-- KOT keys: the line on a card, not the card's own colour -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#7C3AED" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="KOT Pending"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#0D9488" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="KOT Sent"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
