<?xml version="1.0" encoding="utf-8"?>
<!--
  Choose Table: the floor plan as cards, its sections as the categories across the
  top, and a legend along the foot keying each colour to a status.

  Full screen by design - the card fills the window edge to edge, so the floor gets
  the whole display whatever its size and whether or not there is a table to show.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:id="@+id/llDialogContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <!--
          Title + close.

          The search box that stood between them is gone. A floor plan is read one
          room at a time and every table in the room is already on screen at eight to
          a row - so the thing being searched for is in plain sight, and a box that
          lifts the section to find it was answering a question the section chips and
          the grid answer between them. Its going gives the band below the full width.
        -->
        <!-- The header row is gone entirely.
             It held the "Choose Table" title, and once that went it was a 44dp band
             holding one button. The close cross moved down into the order band, which
             already runs the full width and had room at its end - so the popup is a
             whole row shorter and every pixel of it went to the floor plan, which is
             the part of this card worth the room. -->

        <!--
          ORDER BAND: what kind of order this is, and who it is for.

          Replaces the Total/Available count strip that stood here. Those two numbers
          answered a question the floor plan below already answers at a glance - the
          green cards ARE the available tables - and they took the most valuable band
          on the screen, directly under the title, to do it.

          What belongs in that band is the decision the operator came here to make.
          They opened this to start an order, and an order needs a KIND before it
          needs a table: a take-away or a QSR ticket has no table to pick at all.

          BUILT AS THE SALES PAGE BUILDS IT. The modes are a
          MaterialButtonToggleGroup with the same singleSelection/selectionRequired
          and the same metrics as segOrderType behind this dialog - 36dp tall, 13sp,
          14dp of horizontal padding, 10dp corners - and the customer button carries
          the action-button metrics its Table Actions and Add Customer neighbours use
          there. Opening the floor plan should not feel like arriving on a screen
          somebody else designed.
        -->
        <LinearLayout
            android:id="@+id/llTableAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp">

            <!-- One control of three, not three buttons that happen to sit together:
                 the group enforces the single answer, so a mode cannot be left
                 un-chosen and two cannot be lit at once. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/segPickerMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeDineIn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    android:text="Dine In"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeTakeAway"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    android:text="Take Away"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeQsr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    android:text="QSR"
                    app:cornerRadius="10dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- The floor, in three numbers - how many tables are free, taken and
                 waiting to be paid. The grid answers the same question card by card,
                 but only once every card is in view; this is the same fact read at a
                 glance, right beside the choice of what kind of order to start. Dots
                 tinted the same as the cards and the legend at the foot, so a number
                 here and a colour there are one fact, not two to reconcile. -->
            <LinearLayout
                android:id="@+id/llTableStatusCounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#16A34A" />
                <TextView
                    android:id="@+id/tvCountAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="14dp"
                    android:text="0 Available"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#DC2626" />
                <TextView
                    android:id="@+id/tvCountOccupied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="14dp"
                    android:text="0 Occupied"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#2563EB" />
                <TextView
                    android:id="@+id/tvCountBillPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0 Bill Pending"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- The row's spare width, so the customer button sits at the far edge
                 and the two groups read as two. -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- The customer: its own button, apart from the modes, because it answers
                 a different question and can be left unanswered - a walk-in has no
                 name to take. Same metrics as the sales page's own action buttons. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseTableCustomer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:maxLines="1"
                android:textSize="12.5sp"
                android:letterSpacing="0"
                android:text="Add Customer"
                app:icon="@android:drawable/ic_menu_myplaces"
                app:iconSize="16dp"
                app:iconPadding="3dp"
                app:cornerRadius="10dp" />

            <!-- Close, at the far end of the same row.
                 It sits after Add Customer rather than in a band of its own: a row that
                 already spans the card has room at its end, and a whole line of height
                 for one 44dp button is height the floor plan should have. Kept visually
                 apart from the buttons beside it - borderless and greyed, so it reads
                 as the window's control rather than as a third thing to choose. -->
            <ImageButton
                android:id="@+id/btnCloseChooseTable"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Separates the decision band above from the floor plan below, so the two
             read as "what kind of order" and then "which table" rather than as one
             undifferentiated wall of controls. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E4E7EB" />

        <!-- The rooms, as the categories of this grid. Gone for a store that has not
             set any up: one unnamed room is not a choice to offer. -->
        <HorizontalScrollView
            android:id="@+id/svTableSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/llTableSections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E7EB" />

        <!-- The floor, and beside it what is already running on it.

             Two columns rather than one: the grid answers "which table do I take",
             and the panel on the right answers "what is out there" - a waiter picking
             a table is standing in the same room as the orders it lists. Reading it
             meant closing the picker and going back to the order list, which is the
             screen this popup covers.

             The grid keeps the weight and the panel a fixed width, so the floor still
             grows with the screen and the summary stays the same readable column
             whatever size it is on. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- The floor. Takes every pixel between the sections and the legend, so
                 the grid is as tall as the screen allows. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTables"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingHorizontal="13dp"
                android:paddingVertical="14dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <!-- Stands in for the grid, and holds the same space, when there is none -->
            <TextView
                android:id="@+id/tvNoTables"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingVertical="28dp"
                android:gravity="center"
                android:text="No tables set up yet.\nAdd them in Master ▸ Table."
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E4E7EB" />

            <!-- A row taps open to its own items and their subtotals, in place - the
                 order itself is still only opened from the list behind this popup, so
                 a tap here answers "what is on this bill" without leaving the picker
                 to find out. -->
            <LinearLayout
                android:id="@+id/llActiveSummary"
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#F7F8FA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIVE ORDERS"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <!-- The count as a pill, tinted with the theme in code - the same
                         badge the Active Orders list behind this popup carries, so the
                         two read as the same thing counted once. -->
                    <TextView
                        android:id="@+id/tvActiveSummaryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="24dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_kot_count" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4E7EB" />

                <!-- The rows. Scrolls on its own, so a busy floor does not push the
                     total off the bottom - that figure is the reason to look here. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llActiveSummaryRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/tvActiveSummaryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="Nothing running yet.\nPick a table to start."
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4E7EB" />

                <!-- The figure the panel exists for, pinned to the foot where a total
                     belongs and where it cannot scroll away. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL"
                        android:textSize="14sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvActiveSummaryTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 0.00"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E7EB" />

        <!-- Legend: what each colour on the cards above means. Scrolls rather than
             squeezing, so the KOT keys can sit beside the table statuses. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/bg_light"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#16A34A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Available Table"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#DC2626" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Occupied Table"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <!-- No Reserved key: nothing in the app books a table ahead, so the
                     Table master no longer offers that status and no card can be in
                     it. A key for a colour that never appears is a colour to look
                     for on the floor plan and never find. -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#2563EB" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="22dp"
                    android:text="Bill Pending"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <!-- Cleaning and Blocked. Both are statuses the Table master sets, so
                     both DO appear on the grid - they were the two colours on the
                     floor plan with nothing here to name them, which is the half of a
                     legend that sends the eye back to the cards guessing. -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#F59E0B" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="18dp"
                    android:text="Cleaning"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_legend_dot"
                    android:backgroundTint="#475569" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="22dp"
                    android:text="Blocked"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <!-- No KOT keys. The cards no longer take a kitchen colour, so a
                     purple and a teal key here would name two colours that never
                     appear on the floor plan - and a legend listing colours the grid
                     cannot show is worse than no legend, because it sends the eye
                     looking for them. Where an order stands with the kitchen is on
                     the ticket and on the order panel. -->
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
