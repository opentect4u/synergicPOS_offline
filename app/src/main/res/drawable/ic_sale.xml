<?xml version="1.0" encoding="utf-8"?>
<!--
  The header's shortcut to the sale screen, drawn as a bill - a till receipt with its
  torn top and bottom and the printed lines down it.

  It began as a shopping trolley, then became a currency mark. A bill says what the
  screen is FOR in a till's own terms - it is where the bill is made - and does not
  read as a dollar sign in a shop that charges in rupees.

  Kept in this file rather than added as a new one so nothing else has to change: the
  header points at ic_sale, and ThemeManager tints btnSale by name, so the mark can be
  redrawn without touching either. Tinted at bind time like the home icon beside it, so
  the two still read as a pair of destinations rather than two unrelated marks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#000000">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M18,17H6v-2h12v2zM18,13H6v-2h12v2zM18,9H6V7h12v2zM3,22l1.5,-1.5L6,22l1.5,-1.5L9,22l1.5,-1.5L12,22l1.5,-1.5L15,22l1.5,-1.5L18,22l1.5,-1.5L21,22V2l-1.5,1.5L18,2l-1.5,1.5L15,2l-1.5,1.5L12,2l-1.5,1.5L9,2 7.5,3.5 6,2 4.5,3.5 3,2v20z" />
