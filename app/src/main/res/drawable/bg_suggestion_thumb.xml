<?xml version="1.0" encoding="utf-8"?>
<!-- The rounded square behind a suggestion's photo, and the plate its initial sits
     on while it has none. Matches the cart line's 8dp thumbnail, so an item looks
     the same on the way in as it does once it is on the order. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EEF1F5" />
    <corners android:radius="8dp" />
</shape>
