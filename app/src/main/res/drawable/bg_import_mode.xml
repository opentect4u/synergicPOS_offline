<?xml version="1.0" encoding="utf-8"?>
<!--
    The box around the append/replace choice on the upload preview.

    Tinted and outlined so the question reads as something to answer rather than as
    more of the summary above it - it is the one control on that dialog that can
    remove the operator's catalogue.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF8E1" />
    <stroke
        android:width="1dp"
        android:color="#F0C36D" />
    <corners android:radius="12dp" />
</shape>
